# ==============================================================================
# NEXORO / TOKIO — VARIÁVEIS DE AMBIENTE (copie para .env e preencha)
# Nunca coloque valores reais neste arquivo de exemplo nem os envie ao Git.
# ==============================================================================

# 1. ADMINISTRADOR
# Senha inicial/recuperação do usuário "admin" (mín. 8 caracteres).
# Quando definida, ela também permite redefinir o admin pelo endpoint de recuperação
# e é sincronizada automaticamente no boot se a senha atual for diferente.
ADMIN_PASSWORD=

# 2. CORS
# Só é necessário se o cardápio/painel forem servidos de OUTRO domínio que a API.
# Mesmo domínio (padrão): deixe vazio. Vários domínios: separe por vírgula.
CORS_ORIGINS=

# 3. CLOUDINARY (upload de fotos do cardápio)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. SUPABASE (cópia de segurança dos pedidos — opcional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# 5. FUSO HORÁRIO
TZ=America/Sao_Paulo

# 6. PORTA (Render define automaticamente; local padrão 3000)
PORT=3000

# 7. GOOGLE GEMINI (assistente/sommelier IA — opcional)
GEMINI_API_KEY=
# Nome do modelo (confirme na documentação do Gemini qual está disponível para sua conta)
GEMINI_MODEL=

# 8. ENVIO DE CÓDIGOS POR WHATSAPP/SMS (recuperação de senha do cliente)
# Sem estes dois campos, em produção a recuperação de senha do cliente fica indisponível.
WHATSAPP_SMS_PROVIDER_API_KEY=
WHATSAPP_SMS_ENDPOINT_URL=

# 9. FISCAL — chave do cofre de certificados A1 (mín. 24 caracteres, aleatória)
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FISCAL_ENCRYPTION_KEY=

# 10. AGENTE DE IMPRESSÃO (opcional): chave enviada no header X-Agent-Key
PRINT_AGENT_KEY=

# 11. SOMENTE DESENVOLVIMENTO: cria pedidos de demonstração na primeira execução
SEED_DEMO_ORDERS=false
